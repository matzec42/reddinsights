      "updated": 1754601126652,
      "link": null,
      "locked": false,
      "text": "{\n    _id: ObjectId (auto generated)\n  userId: string     (references users._id)\n  redditUrl: string      (URL)\n  subreddit: string\n  postTitle: string\n  fetchedAt: ISODate\n  analysisStatus: string    (\"complete\" or \"pending\" for background job)\n  commentCount: number\n  sentimentSummary: {\n        overall: string\n        positive: number\n        negative: number\n        neutral: number\n        distribution: {\n            positive: number,   (as a percentage)\n            negative: number,\n            neutral: number\n        }\n    }\n  topThemes: [\n        { label: string, quote: string },\n        { label: string quote: string}\n  ],\n  rawPromptTokens: Number    (optional, if tracking AI usage)\n  createdAt: ISODate\n}",
      "fontSize": 22.99563217575086,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "{\n    _id: ObjectId (auto generated)\n  userId: string     (references users._id)\n  redditUrl: string      (URL)\n  subreddit: string\n  postTitle: string\n  fetchedAt: ISODate\n  analysisStatus: string    (\"complete\" or \"pending\" for background job)\n  commentCount: number\n  sentimentSummary: {\n        overall: string\n        positive: number\n        negative: number\n        neutral: number\n        distribution: {\n            positive: number,   (as a percentage)\n            negative: number,\n            neutral: number\n        }\n    }\n  topThemes: [\n        { label: string, quote: string },\n        { label: string quote: string}\n  ],\n  rawPromptTokens: Number    (optional, if tracking AI usage)\n  createdAt: ISODate\n}",
      "autoResize": false,
      "lineHeight": 1.25
